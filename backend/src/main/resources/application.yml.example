spring:
  application:
    name: backend

  datasource:
    url: jdbc:postgresql://localhost:5432/delivery_saas
    username: postgres
    password: TU_CONTRASEÑA_AQUI
    driver-class-name: org.postgresql.Driver

  jpa:
    hibernate:
      ddl-auto: validate
    show-sql: true
    properties:
      hibernate:
        format_sql: true

  flyway:
    enabled: true
    locations: classpath:db/migration
    baseline-on-migrate: true

server:
  port: 8080